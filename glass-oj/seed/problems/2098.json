      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>10\r\n8 32 12 25 12 8 36 25 26 12</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>8 12 25 26 32 36</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            10\r\n8 32 12 25 12 8 36 25 26 12\n                        \n                        \n                            输出\n                            8 12 25 26 32 36"
