      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>3\r\n3 6 9</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>3</pre>\n                        </div>\n\n                                                    <div class=\"input\">\n                                <h4>输入</h4>\n                                <pre>1\r\n36</pre>\n                            </div>\n                            <div class=\"output\">\n                                <h4>输出</h4>\n                                <pre>36</pre>\n                            </div>\n                        \n                                                    <div class=\"input\">\n                                <h4>输入</h4>\n                                <pre>10\r\n18 42 66 30 78 54 90 102 126 48</pre>\n                            </div>\n                            <div class=\"output\">\n                                <h4>输出</h4>\n                                <pre>6</pre>\n                            </div>\n                                            </div>\n                </div>",
      "text": "输入\n                            3\r\n3 6 9\n                        \n                        \n                            输出\n                            3\n                        \n\n                                                    \n                                输入\n                                1\r\n36\n                            \n                            \n                                输出\n                                36\n                            \n                        \n                                                    \n                                输入\n                                10\r\n18 42 66 30 78 54 90 102 126 48\n                            \n                            \n                                输出\n                                6"
