      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>4 2\r\n2 6 4 5</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>23</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            4 2\r\n2 6 4 5\n                        \n                        \n                            输出\n                            23"
