      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>5\r\n1 60\r\n3 70\r\n2 80\r\n4 55\r\n4 50</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>8\r\n</pre>\n                        </div>\n\n                                                    <div class=\"input\">\n                                <h4>输入</h4>\n                                <pre>5\r\n4 0\r\n4 0\r\n2 0\r\n3 0\r\n1 0</pre>\n                            </div>\n                            <div class=\"output\">\n                                <h4>输出</h4>\n                                <pre>1</pre>\n                            </div>\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            5\r\n1 60\r\n3 70\r\n2 80\r\n4 55\r\n4 50\n                        \n                        \n                            输出\n                            8\r\n\n                        \n\n                                                    \n                                输入\n                                5\r\n4 0\r\n4 0\r\n2 0\r\n3 0\r\n1 0\n                            \n                            \n                                输出\n                                1"
