      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>3 3\r\n3 4 1\r\n3 7 1\r\n2 0 1</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>7</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            3 3\r\n3 4 1\r\n3 7 1\r\n2 0 1\n                        \n                        \n                            输出\n                            7"
