      "text": "输入\n                            14\n                        \n                        \n                            输出\n                            3\n                        \n\n                                                    \n                                输入\n                                1110\n                            \n                            \n                                输出\n                                21\n                            \n                        \n                                                    \n                                输入\n                                1000000000000\n                            \n                            \n                                输出\n                                283392"
