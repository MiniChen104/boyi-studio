      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>4\r\n3 1 2 4</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>5\r\n3 4 5 6 7</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            4\r\n3 1 2 4\n                        \n                        \n                            输出\n                            5\r\n3 4 5 6 7"
