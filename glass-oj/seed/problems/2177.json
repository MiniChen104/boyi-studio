      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>hello world!\r\nl</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>3 4 10 \r\n3</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            hello world!\r\nl\n                        \n                        \n                            输出\n                            3 4 10 \r\n3"
