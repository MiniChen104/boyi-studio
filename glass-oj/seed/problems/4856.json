      "heading": "输入",
      "html": "<div class=\"content-wrapper\">\n                <div class=\"markdown\"><p>输入一个 <span class=\"katex math inline\">n</span> 代表行数(<span class=\"katex math inline\">1 \\le n \\le 10</span>)</p>\n</div>            </div>",
      "text": "输入一个 n 代表行数(1 \\le n \\le 10)"
