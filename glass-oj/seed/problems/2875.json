      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>10\r\n1 106465\r\n4 1\r\n1 317721\r\n1 460929\r\n1 644985\r\n1 84185\r\n1 89851\r\n6 81968\r\n1 492737\r\n5 493598</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>106465\r\n84185\r\n492737</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
