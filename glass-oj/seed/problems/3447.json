      "html": "<div class=\"content-wrapper\">\n                <div class=\"markdown\"><p>输出数列第 <span class=\"katex math inline\">N</span> 项的值。</p>\n</div>            </div>",
      "text": "输出数列第 N 项的值。"
    },
