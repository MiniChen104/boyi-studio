      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>4 50\r\n10 60\r\n20 100\r\n30 120\r\n15 45</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>240.00</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
