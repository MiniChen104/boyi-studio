      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>qwe\r\njij\r\n3</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>jijqwe</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            qwe\r\njij\r\n3\n                        \n                        \n                            输出\n                            jijqwe"
