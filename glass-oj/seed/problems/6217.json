      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>5\r\n3 5 7 35 105</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>38</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            5\r\n3 5 7 35 105\n                        \n                        \n                            输出\n                            38"
