      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>4\r\n5 9 6 8 7 6\r\n7 7 7 8 6 7\r\n5 7 6 7 5 7\r\n7 7 7 5 9 8</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>6</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            4\r\n5 9 6 8 7 6\r\n7 7 7 8 6 7\r\n5 7 6 7 5 7\r\n7 7 7 5 9 8\n                        \n                        \n                            输出\n                            6"
    },
