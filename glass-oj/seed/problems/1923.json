      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>3 3 1 3\r\n1 2 2\r\n2 3 1\r\n1 3 3</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>2</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            3 3 1 3\r\n1 2 2\r\n2 3 1\r\n1 3 3\n                        \n                        \n                            输出\n                            2"
    },
