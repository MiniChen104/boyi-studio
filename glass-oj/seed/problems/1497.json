      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>8\r\n100 90 98 92 85 70 88 96\r\n2</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>98</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            8\r\n100 90 98 92 85 70 88 96\r\n2\n                        \n                        \n                            输出\n                            98"
