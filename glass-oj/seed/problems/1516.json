      "html": "<div class=\"content-wrapper\">\n                <div class=\"markdown\"><p>若干行，每行 <span class=\"katex math inline\">1</span> 个算式。</p>\n</div>            </div>",
      "text": "若干行，每行 1 个算式。"
    },
