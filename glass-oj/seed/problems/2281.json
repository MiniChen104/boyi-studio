      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>2\r\n-1 17 2 20 5 9 -7 7 10 4 22 2 -15 0 16 5 0 -1\r\n2 19 7 7 3 17 4 4 15 10 -10 5 13 2 -7 0 8 -8\r\n-1 17 2 23 22 2 6 8 -4 7 -18 0 1 5 21 4 0 -1\r\n12 7 -7 5 3 17 23 4 15 10 -10 5 13 5 2 19 9 -7</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>[ 2 20 ] [ 2 19 ] [ 2 17 ] [ 15 10 ] [ 5 9 ] [ 6 5 ] [ 14 4 ] [ 35 2 ] [ -22 0 ]\r\n[ 2 23 ] [ 2 19 ] [ 2 17 ] [ 15 10 ] [ 6 8 ] [ 8 7 ] [ -3 5 ] [ 44 4 ] [ 22 2 ] [ -18 0 ]</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
