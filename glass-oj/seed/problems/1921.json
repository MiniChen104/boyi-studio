      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>6 5 3\r\n1 2\r\n1 5\r\n3 4\r\n5 2\r\n1 3\r\n1 4\r\n2 3\r\n5 6</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>Yes\r\nYes\r\nNo</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
