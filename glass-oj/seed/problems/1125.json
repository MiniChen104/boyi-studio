      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>***ABC123**123*abc***********</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>***ABC123123abc***********</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
