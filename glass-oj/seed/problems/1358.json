      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>4</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>1:1 2 3 4\r\n2:1 4 3 2\r\n3:2 1 4 3\r\n4:2 3 4 1\r\n5:3 2 1 4\r\n6:3 4 1 2\r\n7:4 1 2 3\r\n8:4 3 2 1\r\ntotal:8</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
