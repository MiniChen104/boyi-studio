      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>3\r\n0 0 0\r\n0 1 1\r\n1 0 0</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>2</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            3\r\n0 0 0\r\n0 1 1\r\n1 0 0\n                        \n                        \n                            输出\n                            2"
