      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>2 2 11 4 9 7 9</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>2 2 7</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            2 2 11 4 9 7 9\n                        \n                        \n                            输出\n                            2 2 7"
