      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>2\r\n16347\r\n76344</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>T\r\nF</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            2\r\n16347\r\n76344\n                        \n                        \n                            输出\n                            T\r\nF"
    },
