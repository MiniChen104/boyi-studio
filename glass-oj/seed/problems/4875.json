      "html": "<div class=\"content-wrapper\">\n                    <div class=\"sample-test\">\n                        <div class=\"input\">\n                            <h4>输入</h4>\n                            <pre>3\r\n100004 50 20 15 \r\n100006 45 26 8\r\n100007 42 29 14\r\n</pre>\n                        </div>\n                        <div class=\"output\">\n                            <h4>输出</h4>\n                            <pre>100004 85\r\n100007 85\r\n100006 79\r\n</pre>\n                        </div>\n\n                        \n                                            </div>\n                </div>",
      "text": "输入\n                            3\r\n100004 50 20 15 \r\n100006 45 26 8\r\n100007 42 29 14\r\n\n                        \n                        \n                            输出\n                            100004 85\r\n100007 85\r\n100006 79"
    },
